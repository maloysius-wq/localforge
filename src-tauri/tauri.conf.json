{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalForge",
  "version": "0.3.0",
  "identifier": "dev.localforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "LocalForge", "width": 1320, "height": 850, "minWidth": 900, "minHeight": 570, "backgroundColor": "#0b1120" }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self';" }
  },
  "bundle": {
    "active": true,
    "resources": ["runtime"],
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Offline-first coding workspace",
    "category": "DeveloperTool"
  }
}
